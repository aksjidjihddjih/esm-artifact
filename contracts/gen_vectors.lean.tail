
/-! ================= differential-test oracle generator (appended to a COPY of ESM_verified.lean; never shipped as part of the proof file) ================= -/
namespace ESMGen
open ESM

abbrev R := StateM Nat

def nxt : R Nat := do
  let s ← get
  let s' := (s * 6364136223846793005 + 1442695040888963407) % 18446744073709551616
  set s'
  pure (s' / 65536)

def rbitsV (b : Nat) : R Nat := do
  let a ← nxt
  let c ← nxt
  let d ← nxt
  pure ((a * 281474976710656 * 281474976710656 + c * 281474976710656 + d) % (2 ^ b))

/-- random value in [0, maxV], boundary-heavy (0, 1, maxV, maxV-1 each ~8%) -/
def rnd (maxV : Nat) : R Nat := do
  let r ← nxt
  let k := r % 12
  if k == 0 then pure 0
  else if k == 1 then pure 1
  else if k == 2 then pure maxV
  else if k == 3 then pure (maxV - 1)
  else do
    let r2 ← nxt
    let szs := #[1, 3, 5, 8, 16, 24, 32, 48, 64, 96]
    let b := szs[r2 % szs.size]!
    let v ← rbitsV b
    pure (v % (maxV + 1))

def tokMax : Nat := 2 ^ 96 - 1
def bitsMax : Nat := 2 ^ 40
def smallTok : Nat := 2 ^ 90
def smallBits : Nat := 2 ^ 38

def dsStr (s : DataState) : String :=
  s!"{s.B0} {s.Phi0} {s.Phi_best} {s.d_init} {s.d_abs} {s.d_hold} {s.d_settled} {s.e_init} {s.e_abs} {s.e_hold} {s.e_settled} {s.B_rem}"

def rState : R DataState := do
  let B0 ← rnd smallTok
  let Phi0 ← rnd smallBits
  let Pb ← rnd smallBits
  let di ← rnd smallBits
  let da ← rnd smallBits
  let dh ← rnd smallBits
  let ds ← rnd smallBits
  let ei ← rnd smallTok
  let ea ← rnd smallTok
  let eh ← rnd smallTok
  let es ← rnd smallTok
  let br ← rnd smallTok
  pure { B0 := B0, Phi0 := Phi0, Phi_best := Pb, d_init := di, d_abs := da, d_hold := dh, d_settled := ds,
         e_init := ei, e_abs := ea, e_hold := eh, e_settled := es, B_rem := br }

def gen (n : Nat) : R (Array String) := do
  let mut out : Array String := #[]
  for _ in [0:n] do
    let B ← rnd tokMax
    let Phi ← rnd bitsMax
    let d ← rnd bitsMax
    out := out.push s!"ESC {B} {Phi} {d} {escrowAlloc B Phi d}"
    let a ← rnd (2 ^ 128)
    let b ← rnd (2 ^ 128)
    out := out.push s!"CEIL {a} {b} {ceilDiv a b}"
    let g ← rnd 20000
    let en ← rnd tokMax
    let x ← rnd bitsMax
    let dt ← rnd bitsMax
    out := out.push s!"ROY {g} {en} {x} {dt} {calcRoyalty g en x dt}"
    let e1 ← rnd tokMax
    let dtr ← rnd bitsMax
    let drm ← rnd bitsMax
    out := out.push s!"SAFEREM {B} {Phi} {e1} {dtr} {drm} {safeRemEscrow B Phi e1 dtr drm}"
    let L ← rnd bitsMax
    let C ← rnd tokMax
    let B2 ← rnd tokMax
    let net ← rnd 10000
    out := out.push s!"AMORT {L} {C} {B2} {Phi} {net} {calcAmortGen L C B2 Phi net}"
    let dsv ← rnd bitsMax
    out := out.push s!"NETRWD {B} {Phi} {dsv} {net} {calcNetRewardGen B Phi dsv net}"
    let treq ← rnd (2 ^ 64)
    let nep ← rnd (2 ^ 32)
    let nep1 := nep + (if nep == 0 then 1 else 0)
    out := out.push s!"TEFF {treq} {nep1} {calcTEff treq nep1}"
    let sv ← rnd bitsMax
    let sg ← rnd bitsMax
    let dd ← rnd bitsMax
    out := out.push s!"STAGE1 {sv} {sg} {dd} {allocStage1Single sv sg dd}"
    let w0 ← rnd (2 ^ 93)
    let l0 ← rnd (2 ^ 93)
    let b0 ← rnd (2 ^ 93)
    let m0 ← rnd (2 ^ 93)
    let wo ← rnd (2 ^ 93)
    let wi ← rnd (2 ^ 93)
    let lo ← rnd (2 ^ 93)
    let li ← rnd (2 ^ 93)
    let ba ← rnd (2 ^ 93)
    let ma ← rnd (2 ^ 93)
    let sup : SupplyState := { wallets := w0, locked := l0, burned := b0, minted := m0 }
    let r := applyLedgerTx sup wo wi lo li ba ma
    out := out.push s!"SUPPLY {w0} {l0} {b0} {m0} {wo} {wi} {lo} {li} {ba} {ma} {r.wallets} {r.locked} {r.burned} {r.minted}"
    let st ← rState
    let pn ← rnd smallBits
    let bn ← rnd smallTok
    out := out.push s!"ADOPT {dsStr st} {pn} {bn} {dsStr (stepAdopt st pn bn)}"
    let du ← rnd (2 ^ 39)
    out := out.push s!"PUNC {dsStr st} {du} {dsStr (stepPunctureConcrete st du)}"
    let ha ← rnd smallBits
    out := out.push s!"HOLD {dsStr st} {ha} {dsStr (stepHoldExpire st ha)}"
    out := out.push s!"SINIT {dsStr st} {dsStr (stepSettleInit st)}"
    out := out.push s!"SABS {dsStr st} {dsStr (stepSettleAbs st)}"
  pure out

end ESMGen

def main : IO Unit := do
  let (lines, _) := (ESMGen.gen 2500).run 20260810
  for l in lines do
    IO.println l
